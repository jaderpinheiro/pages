# Priorizar WordPress (index.php) sobre index.html estático
<IfModule mod_dir.c>
DirectoryIndex index.php index.html
</IfModule>

# BEGIN WordPress
<IfModule mod_rewrite.c>
RewriteEngine On
RewriteBase /
RewriteRule ^index\.php$ - [L]
# REST API explícita (garante roteamento mesmo sem AllowOverride All global)
RewriteRule ^wp-json/(.*)$ index.php [QSA,L]
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule . index.php [L]
</IfModule>
# END WordPress
